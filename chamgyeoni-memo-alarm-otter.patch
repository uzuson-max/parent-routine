diff --git a/docs/sql/2026-10-12_notes_reminders.sql b/docs/sql/2026-10-12_notes_reminders.sql
new file mode 100644
index 0000000..718dbd1
--- /dev/null
+++ b/docs/sql/2026-10-12_notes_reminders.sql
@@ -0,0 +1,62 @@
+-- docs/sql/2026-10-12_notes_reminders.sql
+-- 바다 위 메모(sea_notes) + 알람(reminders). Supabase SQL Editor에서 한 번 실행.
+-- 여러 번 실행해도 안전하다(IF NOT EXISTS / DROP POLICY IF EXISTS). 기존 테이블은 건드리지 않는다.
+--
+-- 앱 서버(API)는 service role로 접근하고 매 요청마다 user_id를 직접 확인한다(lib/auth.ts).
+-- RLS는 "앱에서 anon 키로 직접 읽는 일이 생겨도 남의 것은 안 보이게" 하는 두 번째 잠금이다.
+
+-- ---------------------------------------------------------------------------
+-- 1) 바다 위 메모 — 짧은 글. 기억 엔진/인사이트/SMS 대상이 아니다.
+-- ---------------------------------------------------------------------------
+create table if not exists public.sea_notes (
+  id bigint generated always as identity primary key,
+  user_id uuid not null references auth.users(id) on delete cascade,
+  body text not null check (char_length(btrim(body)) between 1 and 1000),
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  last_opened_at timestamptz -- 메모를 다시 열어본 마지막 시각(수달이 "오랜만이네" 할 근거)
+);
+create index if not exists sea_notes_user_created_idx on public.sea_notes (user_id, created_at desc);
+
+alter table public.sea_notes enable row level security;
+drop policy if exists sea_notes_owner on public.sea_notes;
+create policy sea_notes_owner on public.sea_notes
+  for all using (user_id = auth.uid()) with check (user_id = auth.uid());
+
+-- ---------------------------------------------------------------------------
+-- 2) 알람 — 사용자가 직접 정한 시각에 한 번 알려준다.
+--    status 흐름: scheduled → sending → sent | failed   (취소하면 canceled)
+--    sending은 발송 크론이 "내가 보낼게"라고 잡아둔 상태 — 두 번 보내지 않기 위한 잠금이다.
+-- ---------------------------------------------------------------------------
+create table if not exists public.reminders (
+  id bigint generated always as identity primary key,
+  user_id uuid not null references auth.users(id) on delete cascade,
+  title text not null check (char_length(btrim(title)) between 1 and 40),
+  remind_at timestamptz not null,
+  status text not null default 'scheduled'
+    check (status in ('scheduled', 'sending', 'sent', 'failed', 'canceled')),
+  source text not null default 'manual' check (source in ('manual', 'voice', 'note')),
+  source_entry_id uuid,                 -- 음성 일정에서 만든 알람이면 그 voice_entries.id
+  note_id bigint references public.sea_notes(id) on delete set null, -- 메모에서 만든 알람이면 그 메모
+  channel text check (channel in ('push', 'sms')), -- 실제로 전달된 수단
+  attempts smallint not null default 0,
+  last_error text,
+  sent_at timestamptz,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+-- 발송 크론이 "지금 보낼 것"을 빨리 찾게
+create index if not exists reminders_due_idx on public.reminders (remind_at) where status = 'scheduled';
+create index if not exists reminders_user_idx on public.reminders (user_id, remind_at desc);
+-- 같은 녹음에서 알람이 두 번 만들어지지 않게(버튼 두 번 누름 등)
+create unique index if not exists reminders_one_per_entry on public.reminders (user_id, source_entry_id)
+  where source_entry_id is not null and status <> 'canceled';
+
+alter table public.reminders enable row level security;
+drop policy if exists reminders_owner on public.reminders;
+create policy reminders_owner on public.reminders
+  for all using (user_id = auth.uid()) with check (user_id = auth.uid());
+
+-- 되돌리기(필요할 때만):
+-- drop table if exists public.reminders;
+-- drop table if exists public.sea_notes;
diff --git a/docs/sql/2026-10-12_reminder_cron.sql b/docs/sql/2026-10-12_reminder_cron.sql
new file mode 100644
index 0000000..07203e4
--- /dev/null
+++ b/docs/sql/2026-10-12_reminder_cron.sql
@@ -0,0 +1,54 @@
+-- docs/sql/2026-10-12_reminder_cron.sql
+-- 알람 발송 스케줄러 — Supabase가 1분마다 /api/cron/send-reminders 를 부른다.
+-- 먼저 docs/sql/2026-10-12_notes_reminders.sql 을 실행한 뒤에 실행할 것.
+--
+-- 왜 Supabase인가: Vercel Cron은 Hobby 요금제에서 하루 1번까지만 돌아서 "11시에 알려줘"를 지킬 수 없다.
+-- pg_cron(스케줄) + pg_net(HTTP 호출)은 Supabase에 기본으로 들어 있는 확장이고 추가 비용이 없다.
+--
+-- ⚠️ 실행 전에 아래 두 값을 바꿀 것 (CRON_SECRET은 Vercel 환경변수의 그 값 그대로)
+--   <APP_URL>      예: https://parent-routine.vercel.app   (끝에 / 없이)
+--   <CRON_SECRET>  Vercel → Settings → Environment Variables → CRON_SECRET
+-- 비밀값은 SQL 본문이 아니라 Vault에 넣어두고 꺼내 쓴다(크론 목록에 비밀이 그대로 보이지 않게).
+
+create extension if not exists pg_cron;
+create extension if not exists pg_net;
+
+-- 비밀값 보관 (이미 있으면 갱신)
+do $$
+begin
+  if exists (select 1 from vault.secrets where name = 'chamgyeoni_app_url') then
+    perform vault.update_secret((select id from vault.secrets where name = 'chamgyeoni_app_url'), '<APP_URL>');
+  else
+    perform vault.create_secret('<APP_URL>', 'chamgyeoni_app_url');
+  end if;
+  if exists (select 1 from vault.secrets where name = 'chamgyeoni_cron_secret') then
+    perform vault.update_secret((select id from vault.secrets where name = 'chamgyeoni_cron_secret'), '<CRON_SECRET>');
+  else
+    perform vault.create_secret('<CRON_SECRET>', 'chamgyeoni_cron_secret');
+  end if;
+end $$;
+
+-- 같은 이름의 작업이 있으면 지우고 다시 등록(여러 번 실행해도 하나만 남는다)
+select cron.unschedule(jobid) from cron.job where jobname = 'chamgyeoni-send-reminders';
+
+select cron.schedule(
+  'chamgyeoni-send-reminders',
+  '* * * * *',
+  $$
+  select net.http_get(
+    url := (select decrypted_secret from vault.decrypted_secrets where name = 'chamgyeoni_app_url') || '/api/cron/send-reminders',
+    headers := jsonb_build_object(
+      'Authorization', 'Bearer ' || (select decrypted_secret from vault.decrypted_secrets where name = 'chamgyeoni_cron_secret')
+    ),
+    timeout_milliseconds := 55000
+  );
+  $$
+);
+
+-- 잘 도는지 확인:
+--   select jobid, jobname, schedule, active from cron.job;
+--   select status, return_message, start_time from cron.job_run_details order by start_time desc limit 5;
+--   select status_code, content::text, created from net._http_response order by created desc limit 5;
+--
+-- 끄기:
+--   select cron.unschedule('chamgyeoni-send-reminders');
diff --git a/lib/deskClient.ts b/lib/deskClient.ts
new file mode 100644
index 0000000..7ee6d2f
--- /dev/null
+++ b/lib/deskClient.ts
@@ -0,0 +1,85 @@
+// lib/deskClient.ts
+"use client";
+// ============================================================================
+// 바다 위 메모/알람 — 브라우저 쪽 API 호출. 결과는 항상 { ok, data | error, code }로 돌려준다(throw 안 함).
+// 화면은 실패를 숨기지 않고 error 문장을 그대로 보여준다.
+// ============================================================================
+import { supabaseClient } from "@/lib/supabaseClient";
+
+export interface NoteItem {
+  id: number;
+  body: string;
+  createdAt: string;
+  updatedAt: string;
+  lastOpenedAt: string | null;
+}
+
+export interface ReminderItem {
+  id: number;
+  title: string;
+  remindAt: string;
+  status: "scheduled" | "sending" | "sent" | "failed" | "canceled";
+  source: "manual" | "voice" | "note";
+  sourceEntryId: string | null;
+  noteId: number | null;
+  channel: "push" | "sms" | null;
+  attempts: number;
+  lastError: string | null;
+  sentAt: string | null;
+  createdAt: string;
+}
+
+export interface Delivery {
+  push: boolean;
+  sms: boolean;
+}
+
+export type ApiResult<T> = { ok: true; data: T } | { ok: false; error: string; code?: string; status: number };
+
+async function call<T>(path: string, init: RequestInit = {}): Promise<ApiResult<T>> {
+  try {
+    const {
+      data: { session },
+    } = await supabaseClient.auth.getSession();
+    if (!session) return { ok: false, error: "로그인이 아직 안 됐어. 새로고침하면 돼.", status: 401 };
+    const res = await fetch(path, {
+      ...init,
+      headers: {
+        ...(init.body ? { "Content-Type": "application/json" } : {}),
+        Authorization: `Bearer ${session.access_token}`,
+        ...(init.headers || {}),
+      },
+    });
+    const body = await res.json().catch(() => ({}));
+    if (!res.ok || !body?.success) {
+      return { ok: false, error: body?.error || `문제가 생겼어 (${res.status})`, code: body?.code, status: res.status };
+    }
+    return { ok: true, data: body.data as T };
+  } catch {
+    return { ok: false, error: "인터넷이 끊긴 것 같아.", status: 0 };
+  }
+}
+
+export const notesApi = {
+  list: (q?: string) => call<{ notes: NoteItem[] }>(`/api/user/notes${q ? `?q=${encodeURIComponent(q)}` : ""}`),
+  create: (body: string) => call<{ note: NoteItem }>("/api/user/notes", { method: "POST", body: JSON.stringify({ body }) }),
+  update: (id: number, body: string) => call<{ note: NoteItem }>(`/api/user/notes/${id}`, { method: "PATCH", body: JSON.stringify({ body }) }),
+  opened: (id: number) =>
+    call<{ note: NoteItem; previousOpenedAt: string | null }>(`/api/user/notes/${id}`, { method: "PATCH", body: JSON.stringify({ opened: true }) }),
+  remove: (id: number) => call<unknown>(`/api/user/notes/${id}`, { method: "DELETE" }),
+};
+
+export const remindersApi = {
+  list: () => call<{ reminders: ReminderItem[]; delivery: Delivery }>("/api/user/reminders"),
+  create: (input: { title: string; remind_at: string; source?: "manual" | "voice" | "note"; source_entry_id?: string; note_id?: number }) =>
+    call<{ reminder: ReminderItem; existed: boolean; delivery: Delivery }>("/api/user/reminders", { method: "POST", body: JSON.stringify(input) }),
+  update: (id: number, patch: { title?: string; remind_at?: string }) =>
+    call<{ reminder: ReminderItem }>(`/api/user/reminders/${id}`, { method: "PATCH", body: JSON.stringify(patch) }),
+  cancel: (id: number) => call<unknown>(`/api/user/reminders/${id}`, { method: "DELETE" }),
+};
+
+/** 지금 쓸 수 있는 채널 — 앱 알림 우선(발송기와 같은 순서) */
+export function likelyChannel(d: Delivery | null): "push" | "sms" | null {
+  if (!d) return null;
+  return d.push ? "push" : d.sms ? "sms" : null;
+}
diff --git a/lib/otterCues.ts b/lib/otterCues.ts
new file mode 100644
index 0000000..b9a2060
--- /dev/null
+++ b/lib/otterCues.ts
@@ -0,0 +1,168 @@
+// lib/otterCues.ts
+// ============================================================================
+// 참견이(수달)가 언제, 어떻게 반응할지 — 한 곳에서만 정한다. 화면 컴포넌트는 이벤트만 넘기고 결과를 그린다.
+// ----------------------------------------------------------------------------
+// 원칙
+//   1) 실제 상태에서만 말한다. 저장 안 된 걸 아는 척하지 않고, 새 인사이트를 지어내지 않는다.
+//      (기억 회상은 기존 경로 그대로 — 홈 말풍선/기억 캡슐이 서버 데이터로만 한다. 여기서 만들지 않는다.)
+//   2) 기능 안내는 처음 한 번만. 이미 쓴 기능은 다시 설명하지 않는다(기기에 기억).
+//   3) 할 말 없으면 조용히. 대부분의 반응은 표정/움직임만이고 말은 null이다.
+//   4) AI를 부르지 않는다. 전부 규칙 + 이미 있는 데이터.
+//   5) 출석·연속 기록·개수 자랑·평가 없음.
+// 말투: 반말, 명령형 종결/과공손체 없음(질문형·제안형 "~해도 돼"·혼잣말).
+// 테스트: scripts/test-otter-cues.ts
+// ============================================================================
+import type { OtterExpression } from '@/components/Otter';
+import { kstLabel } from '@/lib/reminders/rules';
+
+export interface OtterCue {
+  expression: OtterExpression;
+  line: string | null; // null = 말 없이 표정/움직임만
+  ms: number; // 얼마나 보여줄지
+  motion?: 'nod' | 'hop' | 'peek' | 'look'; // 바깥 CSS가 쓰는 짧은 움직임 이름
+}
+
+export type OtterEvent =
+  | { type: 'home_first_visit' }
+  | { type: 'note_saved' }
+  | { type: 'note_reopened'; createdAt: string; previousOpenedAt: string | null }
+  | { type: 'reminder_set'; remindAt: string; channel: 'push' | 'sms' | null }
+  | { type: 'reminder_failed'; id: number; title: string }
+  | { type: 'deep_arrive'; night: boolean; nextReminder: { title: string; at: string } | null }
+  | { type: 'idle' };
+
+// ---- 기기에 남기는 "이미 겪은 것" — 첫 안내를 한 번만 하기 위한 기록 ----
+const KEY = 'ganseobi_otter_v1';
+export interface OtterMemory {
+  homeIntro?: boolean;
+  firstNote?: boolean;
+  firstReminder?: boolean;
+  failedSeen?: number[];
+  lastGreetAt?: number;
+}
+
+export function loadOtterMemory(): OtterMemory {
+  try {
+    const raw = localStorage.getItem(KEY);
+    return raw ? (JSON.parse(raw) as OtterMemory) : {};
+  } catch {
+    return {};
+  }
+}
+
+export function saveOtterMemory(m: OtterMemory) {
+  try {
+    localStorage.setItem(KEY, JSON.stringify({ ...m, failedSeen: (m.failedSeen ?? []).slice(-50) }));
+  } catch {
+    /* 못 남기면 다음에 한 번 더 말할 뿐 */
+  }
+}
+
+const DAY = 86_400_000;
+export const GREET_GAP_MS = 6 * 60 * 60 * 1000; // 심해 인사는 6시간에 한 번 이하
+export const REOPEN_GAP_DAYS = 14; // 2주 넘게 안 본 메모를 열었을 때만 "오랜만이네"
+
+/** 얼마 전인지 — 숫자를 들이밀지 않는 말로 */
+export function agoWords(iso: string, now: Date): string {
+  const days = (now.getTime() - new Date(iso).getTime()) / DAY;
+  if (days < 21) return '2주도 더 전';
+  if (days < 45) return '한 달 전쯤';
+  if (days < 75) return '두 달 전쯤';
+  return '꽤 오래전';
+}
+
+/**
+ * 이벤트 → 반응. mem은 읽기만 하고, 바뀐 기록을 next로 돌려준다(저장은 부르는 쪽이 saveOtterMemory로).
+ * 반응할 게 없으면 cue: null.
+ */
+export function decideCue(ev: OtterEvent, mem: OtterMemory, now: Date = new Date()): { cue: OtterCue | null; next: OtterMemory } {
+  switch (ev.type) {
+    case 'home_first_visit': {
+      if (mem.homeIntro) return { cue: null, next: mem };
+      return {
+        cue: { expression: 'tilt', line: '말로 하기 애매한 건 위에 적어둬도 돼.', ms: 5200, motion: 'peek' },
+        next: { ...mem, homeIntro: true },
+      };
+    }
+    case 'note_saved': {
+      if (!mem.firstNote) {
+        return {
+          cue: { expression: 'laugh', line: '띄워놨어. 여기 계속 떠 있어.', ms: 3200, motion: 'hop' },
+          next: { ...mem, firstNote: true },
+        };
+      }
+      // 두 번째부터는 말 없이 끄덕 — 저장됐다는 건 목록에 새 쪽지가 떨어지는 걸로 보인다.
+      return { cue: { expression: 'base', line: null, ms: 1200, motion: 'nod' }, next: mem };
+    }
+    case 'note_reopened': {
+      const last = ev.previousOpenedAt && new Date(ev.previousOpenedAt) > new Date(ev.createdAt) ? ev.previousOpenedAt : ev.createdAt;
+      const gapDays = (now.getTime() - new Date(last).getTime()) / DAY;
+      if (gapDays < REOPEN_GAP_DAYS) return { cue: null, next: mem };
+      const what = ev.previousOpenedAt ? '마지막으로 본 게' : '이거 띄운 게';
+      return {
+        cue: { expression: 'surprise', line: `어, ${what} ${agoWords(last, now)}네.`, ms: 3600, motion: 'look' },
+        next: mem,
+      };
+    }
+    case 'reminder_set': {
+      const when = kstLabel(ev.remindAt, now);
+      if (!mem.firstReminder) {
+        const how = ev.channel === 'sms' ? ' 문자로 갈게.' : ev.channel === 'push' ? ' 알림으로 갈게.' : '';
+        return {
+          cue: { expression: 'remember', line: `${when}에 찾아갈게.${how}`, ms: 4200, motion: 'hop' },
+          next: { ...mem, firstReminder: true },
+        };
+      }
+      return { cue: { expression: 'base', line: null, ms: 1200, motion: 'nod' }, next: mem };
+    }
+    case 'reminder_failed': {
+      const seen = mem.failedSeen ?? [];
+      if (seen.includes(ev.id)) return { cue: null, next: mem };
+      return {
+        cue: { expression: 'surprise', line: `“${ev.title}” 알람, 그때 못 알려줬어.`, ms: 4800, motion: 'look' },
+        next: { ...mem, failedSeen: [...seen, ev.id] },
+      };
+    }
+    case 'deep_arrive': {
+      // 심해에 내려올 때마다 인사하지 않는다 — 6시간에 한 번 이하.
+      if (mem.lastGreetAt && now.getTime() - mem.lastGreetAt < GREET_GAP_MS) return { cue: null, next: mem };
+      const soon = ev.nextReminder && new Date(ev.nextReminder.at).getTime() - now.getTime() < 3 * 60 * 60 * 1000;
+      const line = soon && ev.nextReminder
+        ? `${kstLabel(ev.nextReminder.at, now)}에 “${ev.nextReminder.title}” 알려줄 거 있어.`
+        : ev.night
+        ? '…음? 이 시간에 왔어?'
+        : '어, 왔어?';
+      return { cue: { expression: 'surprise', line, ms: 2800, motion: 'hop' }, next: { ...mem, lastGreetAt: now.getTime() } };
+    }
+    case 'idle':
+    default:
+      return { cue: null, next: mem };
+  }
+}
+
+export interface DeepFacts {
+  fishCount: number;
+  stage: number;
+  noteCount: number | null; // 모르면 null(아직 못 불러옴)
+  nextReminder: { title: string; at: string } | null;
+}
+
+/**
+ * 심해에서 참견이를 눌렀을 때 할 수 있는 말 — 지금 실제 상태로만 만든다. 같은 말을 연달아 하지 않고,
+ * 할 말을 다 하면 n이 넘어가도 더 만들어내지 않는다(null → 말 없이 웃기만).
+ */
+export function deepTapLines(f: DeepFacts, now: Date = new Date()): string[] {
+  const lines: string[] = [];
+  if (f.nextReminder) lines.push(`${kstLabel(f.nextReminder.at, now)}에 “${f.nextReminder.title}” 알려줄게.`);
+  if (f.fishCount > 0) lines.push('위에 헤엄치는 애들, 전부 니가 한 생각이야.');
+  else lines.push('위에 아직 물고기가 없네. 뭐라도 말해도 돼.');
+  if (f.noteCount !== null && f.noteCount > 0) lines.push('적어둔 쪽지들은 위에 떠 있어.');
+  lines.push(f.stage >= 2 ? '이 조약돌? 니가 다시 꺼낸 얘기들이야.' : '같은 얘기를 다른 날 또 하면, 그게 조약돌이 돼.');
+  return lines;
+}
+
+export function deepTapCue(f: DeepFacts, tapIndex: number, now: Date = new Date()): OtterCue {
+  const lines = deepTapLines(f, now);
+  if (tapIndex < lines.length) return { expression: 'tilt', line: lines[tapIndex], ms: 3400 };
+  return { expression: 'laugh', line: tapIndex === lines.length ? '간지러워.' : null, ms: 1600 };
+}
